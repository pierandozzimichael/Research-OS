{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local literature screening response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "relevance": {"type": "string", "enum": ["high", "medium", "low", "none"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_code": {"type": "string", "enum": ["direct-topic-match", "adjacent-mechanism", "methods-resource", "weak-match", "not-relevant", "insufficient-abstract"]},
    "matched_terms": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
    "evidence_spans": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "recommended_use": {"type": "string", "enum": ["frontier-review", "methods-background", "watchlist", "ignore"]},
    "abstain_reason": {"type": "string"}
  },
  "required": ["relevance", "confidence", "reason_code", "matched_terms", "evidence_spans", "recommended_use", "abstain_reason"]
}
